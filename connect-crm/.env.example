# Local Vite dev only. The Kestrel build ignores this and uses
# crmappointza-urls.json → frontendApiBaseUrl (next to crmappointza.exe).

VITE_API_BASE_URL=http://localhost:5050

# Mock / offline UI only:
# VITE_API_BASE_URL=

# Map tab — Places API (New), browser only (HTTP referrer restriction)
VITE_GOOGLE_MAPS_API_KEY=
# Optional fallback if primary key is unset
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
